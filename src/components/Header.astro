---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header>
  <nav class="flex align-center justify-between mx-auto py-4 max-w-3/4">
    <h1 class="text-2xl logo max-w-min font-cool">
      <a href="/">{SITE_TITLE}</a>
    </h1>
    <!--
    TODO about page
    <div class="internal-links">
      <HeaderLink href="/about">About</HeaderLink>
    </div>
    -->
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }

  h2 a,
  h2 a.active {
    text-decoration: underline;
  }

  nav a {
    padding: 1em 0.5em;
    color: var(--black);
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }
</style>
